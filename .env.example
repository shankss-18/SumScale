# =============================================================================
# OmniAid — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control — it is listed in .gitignore.
# The backend will REFUSE TO START if any required variable is missing.
# =============================================================================

# ---------------------------------------------------------------------------
# LLM Provider (Google Gemini)
# Get your key from: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# Speech-to-Text API
# Google Cloud Speech-to-Text: https://console.cloud.google.com/speech
# ---------------------------------------------------------------------------
SPEECH_TO_TEXT_API_KEY=your_speech_to_text_api_key_here

# ---------------------------------------------------------------------------
# Google Places / Maps API
# https://console.cloud.google.com/google/maps-apis
# Required scopes: Places API (New), Maps JavaScript API
# ---------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ---------------------------------------------------------------------------
# MongoDB (async via motor)
# Local example: mongodb://localhost:27017
# Atlas example: mongodb+srv://user:pass@cluster.mongodb.net
# ---------------------------------------------------------------------------
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=omniaid

# ---------------------------------------------------------------------------
# JWT Authentication
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(64))"
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=your_very_strong_random_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------------------
# CORS — must be the exact frontend origin, no trailing slash
# Development default: http://localhost:5173
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
